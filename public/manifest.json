{
  "manifest_version": 3,
  "name": "AI Coach - 洛谷提交导出",
  "version": "0.1.0",
  "description": "抓取洛谷提交记录并导出为 JSON，供 AI 分析。",
  "content_scripts": [
    {
      "matches": [
        "https://www.luogu.com.cn/record/*",
        "https://www.luogu.com.cn/user/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
